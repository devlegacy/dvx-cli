{
  "name": "@devexteam/dvx-cli",
  "version": "4.0.0",
  "description": "Image optimization CLI for frontend builds: minify PNG, JPEG, GIF and SVG, convert to WebP, resize with sharp, and validate HTML with HTMLHint.",
  "license": "MIT",
  "main": "bin/index.js",
  "bin": {
    "dvx": "bin/index.js"
  },
  "imports": {
    "#/*": "./*"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "prebuild": "node --run build:clean",
    "build": "node --run prebuild && swc ./src/ --out-dir ./bin/ --strip-leading-paths && replace-in-file \"/#/src//g\" \"#/bin/\" \"./bin/**/*.js\" --isRegex && chmod +x ./bin/*",
    "build:clean": "rm -Rf ./bin",
    "lint": "biome check ./src ./tests",
    "lint:fix": "node --run lint -- --fix",
    "test": "node --run test:unit && node --run test:features",
    "test:features": "node --disable-warning=DEP0205 --import @swc-node/register/esm-register --test \"./tests/features/**/*.test.ts\"",
    "test:unit": "node --disable-warning=DEP0205 --import @swc-node/register/esm-register --test \"./tests/{commands,shared}/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dvx",
    "devexteam",
    "cli",
    "image-optimization",
    "image-compression",
    "minify-images",
    "minify",
    "webp",
    "resize-images",
    "sharp",
    "imagemin",
    "mozjpeg",
    "pngquant",
    "png",
    "jpeg",
    "gif",
    "svg",
    "html-validator",
    "htmlhint",
    "sourcemaps",
    "web-performance",
    "build-tools",
    "assets",
    "frontend"
  ],
  "files": [
    "bin",
    "README.md"
  ],
  "author": "Samuel R. <contact@jstsamuel.dev>",
  "private": false,
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/htmlhint": "1.1.5",
    "@types/imagemin": "9.0.1",
    "@types/imagemin-gifsicle": "7.0.4",
    "@types/imagemin-mozjpeg": "8.0.4",
    "@types/imagemin-svgo": "11.0.0",
    "@types/imagemin-zopfli": "7.0.4",
    "@types/node": "26.6.6",
    "@types/yargs": "17.0.35",
    "@typescript/native": "npm:typescript@7.0.2",
    "replace-in-file": "9.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "htmlhint": "1.9.2",
    "htmlhint-stylish": "1.0.3",
    "imagemin": "9.0.1",
    "imagemin-gifsicle": "7.0.0",
    "imagemin-mozjpeg": "10.0.0",
    "imagemin-pngquant": "10.0.0",
    "imagemin-svgo": "12.0.0",
    "imagemin-zopfli": "7.0.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "yargs": "18.2.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "pnpm": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlegacy/dvx-cli.git"
  },
  "bugs": {
    "url": "https://github.com/devlegacy/dvx-cli/issues"
  },
  "homepage": "https://github.com/devlegacy/dvx-cli#readme",
  "funding": {
    "type": "individual",
    "url": "https://www.paypal.com/donate/?hosted_button_id=PT9RLBAVGWA6S"
  }
}
