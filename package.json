{
  "name": "@devexteam/dvx-cli",
  "version": "3.0.1",
  "description": "CLI that encapsulates utilities for image processing and assets in frontend development.",
  "license": "MIT",
  "main": "bin/index.js",
  "bin": {
    "dvx": "bin/index.js"
  },
  "imports": {
    "#/*": "./*"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "prebuild": "node --run build:clean",
    "build": "swc ./src/ --out-dir ./bin/ --strip-leading-paths && replace-in-file \"/#/src//g\" \"#/bin/\" \"./bin/**/*.js\" --isRegex && chmod +x ./bin/*",
    "build:clean": "rm -Rf ./bin",
    "test": "pnpm run test:unit && pnpm run test:features",
    "test:features": "true",
    "test:unit": "node --import @swc-node/register/esm-register --test ./tests/**/*.test.ts",
    "package:update": "ncu -u && pnpm i && pnpm audit --fix"
  },
  "keywords": [
    "Devexteam",
    "cli",
    "minify",
    "tools",
    "frontend"
  ],
  "files": [
    "bin",
    "assets/icons",
    "README.md"
  ],
  "author": "Samuel R. <contact@jstsamuel.dev>",
  "private": false,
  "devDependencies": {
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.24",
    "@types/htmlhint": "1.1.5",
    "@types/imagemin": "9.0.1",
    "@types/imagemin-gifsicle": "7.0.4",
    "@types/imagemin-jpegtran": "5.0.4",
    "@types/imagemin-mozjpeg": "8.0.4",
    "@types/imagemin-svgo": "11.0.0",
    "@types/imagemin-zopfli": "7.0.4",
    "@types/node": "25.6.0",
    "@types/node-notifier": "8.0.5",
    "@types/yargs": "17.0.35",
    "prettier": "3.8.2",
    "replace-in-file": "8.4.0",
    "type-fest": "5.5.0",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "htmlhint": "1.9.2",
    "htmlhint-stylish": "1.0.3",
    "imagemin": "9.0.1",
    "imagemin-giflossy": "5.1.10",
    "imagemin-gifsicle": "7.0.0",
    "imagemin-jpegtran": "8.0.0",
    "imagemin-mozjpeg": "10.0.0",
    "imagemin-pngquant": "10.0.0",
    "imagemin-svgo": "12.0.0",
    "imagemin-webp": "8.0.0",
    "imagemin-zopfli": "7.0.0",
    "sharp": "0.34.5",
    "svgo": "4.0.1",
    "yargs": "18.0.0"
  },
  "engines": {
    "node": ">=v24",
    "npm": ">=11",
    "pnpm": ">=10"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlegacy/dvx-cli.git"
  },
  "bugs": {
    "url": "https://github.com/devlegacy/dvx-cli/issues"
  },
  "homepage": "https://github.com/devlegacy/dvx-cli#readme",
  "overrides": {
    "braces@<2.3.1": ">=2.3.1",
    "braces@<3.0.3": ">=3.0.3",
    "cross-spawn@<6.0.6": ">=6.0.6",
    "decompress@<4.2.1": ">=4.2.1",
    "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
    "got@<11.8.5": ">=11.8.5",
    "http-cache-semantics@<4.1.1": ">=4.1.1",
    "micromatch@<4.0.8": ">=4.0.8",
    "semver-regex@<3.1.3": ">=3.1.3",
    "semver-regex@<3.1.4": ">=3.1.4",
    "semver@<5.7.2": ">=5.7.2",
    "trim-newlines@<3.0.1": ">=3.0.1",
    "tunnel-agent@<0.6.0": ">=0.6.0",
    "web-worker": "^1.5.0"
  }
}
